rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // --- Documents Collection ---
    match /documents/{docId} {
      // Allow everyone to read and list documents
      allow read: if true;
      
      // Allow only the administrator to create, update, or delete
      // Whitelisting email and UID provided in the error logs
      allow write: if request.auth != null && (
        request.auth.token.email == 'buttmkhithumas@gmail.com' ||
        request.auth.uid == 'kNl7ebZq5lVrmdH8Ua5wJwDnFus2' ||
        request.auth.token.is_admin == true
      );
    }

    // --- User Profiles ---
    match /profiles/{nip} {
      allow read: if true;
      allow write: if true;
    }

    // --- Global Deny ---
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
