rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /documents/{docId} {
      allow read: if true;
      allow create: if request.auth != null || request.resource.data.ownerId == 'custom-admin';
      allow update, delete: if request.auth != null || (resource.data.ownerId == 'custom-admin' && (request.resource == null || request.resource.data.ownerId == 'custom-admin'));
    }
    match /profiles/{nip} {
      allow read, write: if true;
    }
    match /admins/{username} {
      allow read: if true;
    }
    match /{document=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }
  }
}
